// Render: dot -Tpng -Gdpi=150 architecture.dot -o architecture.png
digraph PayPilotShield {
  graph [rankdir=LR, bgcolor="#FBFBF7", fontname="DejaVu Sans", pad=0.4, nodesep=0.5, ranksep=0.7,
         labelloc=t, fontsize=20, label=<<B>PayPilot Shield</B>>];
  node  [shape=box, style="filled,rounded", fillcolor="#FFFFFF", color="#111111", penwidth=2, fontname="DejaVu Sans", fontsize=12, margin="0.2,0.12"];
  edge  [color="#111111", penwidth=1.6, fontname="DejaVu Sans", fontsize=10];

  browser [fillcolor="#FFC2DD", label=<<B>Browser</B><BR/>React app<BR/>signs policy and approvals<BR/>(key never leaves the browser)>];
  nginx   [fillcolor="#DCE4FB", label=<<B>nginx</B><BR/>serves app, proxies /api>];
  api     [fillcolor="#DCE4FB", label=<<B>FastAPI backend</B><BR/>auth, agent, pipeline<BR/>rules decide, verifier checks<BR/>signatures before any payout>];
  db      [shape=cylinder, label=<<B>PostgreSQL</B>>];
  paypal  [fillcolor="#C9F2DD", label=<<B>PayPal Payouts</B><BR/>sandbox>];
  llm     [style="filled,rounded,dashed", label=<<B>LLM</B> (optional)<BR/>agent chat and risk flag<BR/>can only read and raise risk>];

  browser -> nginx -> api;
  api -> db;
  api -> paypal [label="payout, only after\nverifier passes"];
  paypal -> api [label="webhook", style=dashed];
  api -> llm [style=dashed];
}
